{
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  "name": "myresolve-booking",
  "main": "src/index.mjs",
  "compatibility_date": "2026-08-11",
  "routes": [
    {
      "pattern": "api.myresolve.uk",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true
  },
  "ratelimits": [
    {
      "name": "BOOKING_RATE_LIMITER",
      "namespace_id": "1009",
      "simple": {
        "limit": 5,
        "period": 60
      }
    }
  ]
}
