{
  "name": "myresolve",
  "private": true,
  "description": "MYReSolve platform monorepo — locked v0.3.1 assessment + Next.js migration workspace",
  "scripts": {
    "legacy": "npx --yes serve legacy/v0.3.1",
    "web:dev": "npm --prefix apps/web run dev",
    "web:lint": "npm --prefix apps/web run lint",
    "web:build": "npm --prefix apps/web run build",
    "web:start": "npm --prefix apps/web run start",
    "web:test": "npm --prefix apps/web run test",
    "studio:dev": "npm --prefix apps/studio run dev",
    "studio:build": "npm --prefix apps/studio run build",
    "sites:build": "npm run web:build -- --webpack && node scripts/build-sites-static.mjs",
    "booking:test": "node --test workers/booking/src/index.test.mjs",
    "booking:check": "node --check workers/booking/src/index.mjs && node --check workers/booking/src/index.test.mjs",
    "lint": "npm run web:lint && npm run booking:check",
    "build": "npm run web:build",
    "test": "npm run web:test && npm run booking:test"
  }
}
